@{
    ViewData["Title"] = "Notas";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>
            Registro de Notas
        </h1>

        <a class="btn btn-success">
            Nueva Nota
        </a>

    </div>

    <div class="card shadow">

        <div class="card-body">

            <table class="table table-striped table-hover">

                <thead class="table-success">

                    <tr>
                        <th>Estudiante</th>
                        <th>Materia</th>
                        <th>Actividad</th>
                        <th>Nota</th>
                        <th>Periodo</th>
                        <th>Acciones</th>
                    </tr>

                </thead>

                <tbody>

                    <tr>
                        <td>Juan Pérez</td>
                        <td>Matemática</td>
                        <td>Examen Parcial</td>
                        <td>8.5</td>
                        <td>I</td>

                        <td>
                            <button class="btn btn-warning btn-sm">
                                Editar
                            </button>

                            <button class="btn btn-danger btn-sm">
                                Eliminar
                            </button>
                        </td>
                    </tr>

                    <tr>
                        <td>Ana López</td>
                        <td>Ciencias</td>
                        <td>Tarea</td>
                        <td>9.0</td>
                        <td>I</td>

                        <td>
                            <button class="btn btn-warning btn-sm">
                                Editar
                            </button>

                            <button class="btn btn-danger btn-sm">
                                Eliminar
                            </button>
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>