@model List<PortalEscolar.Models.Nota>

@{
    ViewData["Title"] = "Notas";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>
            Registro de Notas
        </h1>

        <a asp-controller="Notas"
           asp-action="Crear"
           class="btn btn-success">

            Nueva Nota

        </a>

    </div>

    <div class="card shadow">

        <div class="card-body">

            <table class="table table-striped table-hover">

                <thead class="table-success">

                    <tr>
                        <th>Estudiante</th>
                        <th>Materia</th>
                        <th>Actividad</th>
                        <th>Nota</th>
                        <th>Periodo</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var nota in Model)
                    {
                        <tr>

                            <td>@nota.estudiante</td>

                            <td>@nota.materia</td>

                            <td>@nota.actividad</td>

                            <td>@nota.nota</td>

                            <td>@nota.periodo</td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>