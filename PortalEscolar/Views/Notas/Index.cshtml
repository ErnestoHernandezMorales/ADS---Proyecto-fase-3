@model List<PortalEscolar.Models.Nota>

@{
    ViewData["Title"] = "Notas";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>
            Registro de Notas
        </h1>

        @if (Context.Session.GetString("rol") == "DOCENTE")
        {
            <a asp-controller="Notas"
               asp-action="Crear"
               class="btn btn-success">

                Nueva Nota

            </a>
        }

    </div>

    <div class="card shadow-lg">

        <div class="card-body">

            <table class="table table-striped table-hover">

                <thead class="table-success">

                    <tr>

                        <th>Estudiante</th>

                        <th>Materia</th>

                        <th>Actividad</th>

                        <th>Nota</th>

                        <th>Periodo</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Count == 0)
                    {
                        <tr>

                            <td colspan="5" class="text-center">

                                No hay notas registradas.

                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var nota in Model)
                        {
                            <tr>

                                <td>@nota.estudiante</td>

                                <td>@nota.materia</td>

                                <td>@nota.actividad</td>

                                <td>@nota.nota</td>

                                <td>@nota.periodo</td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>