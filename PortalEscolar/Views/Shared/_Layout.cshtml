@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Portal Escolar</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    📚 Portal Escolar

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbarNav">

                    <ul class="navbar-nav ms-auto">

                        @if (Context.Session.GetString("rol") != null)
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    🏠 Inicio

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Docente">

                                    📊 Dashboard

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Notas"
                                   asp-action="Index">

                                    📝 Notas

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Avisos"
                                   asp-action="Index">

                                    📢 Avisos

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Mensajes"
                                   asp-action="Index">

                                    💬 Mensajes

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link text-warning"
                                   asp-controller="Login"
                                   asp-action="CerrarSesion">

                                    🚪 Cerrar Sesión

                                </a>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Login"
                                   asp-action="Index">

                                    🔐 Iniciar Sesión

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <div class="container mt-4">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

    <footer class="border-top footer text-muted mt-5">

        <div class="container text-center py-3">

            © 2026 - Portal Escolar | Sistema de comunicación entre padres y docentes

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>