@model List<PortalEscolar.Models.Aviso>

@{
    ViewData["Title"] = "Avisos";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>
            Gestión de Avisos
        </h1>

        <a asp-controller="Avisos"
           asp-action="Crear"
           class="btn btn-primary">

            Nuevo Aviso

        </a>

    </div>

    <div class="card shadow">

        <div class="card-body">

            <table class="table table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>Título</th>
                        <th>Contenido</th>
                        <th>Fecha</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var aviso in Model)
                    {
                        <tr>

                            <td>@aviso.titulo</td>

                            <td>@aviso.contenido</td>

                            <td>
                                @aviso.fecha_publicacion
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>