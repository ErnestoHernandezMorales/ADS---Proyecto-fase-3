@model List<PortalEscolar.Models.Aviso>

@{
    ViewData["Title"] = "Avisos";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>
            Gestión de Avisos
        </h1>

        @if (Context.Session.GetString("rol") == "DOCENTE")
        {
            <a asp-controller="Avisos"
               asp-action="Crear"
               class="btn btn-primary">

                Nuevo Aviso

            </a>
        }

    </div>

    <div class="card shadow-lg">

        <div class="card-body">

            <table class="table table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>Título</th>
                        <th>Contenido</th>
                        <th>Fecha</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center">
                                No hay avisos registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var aviso in Model)
                        {
                            <tr>

                                <td>@aviso.titulo</td>

                                <td>@aviso.contenido</td>

                                <td>@aviso.fecha_publicacion</td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>