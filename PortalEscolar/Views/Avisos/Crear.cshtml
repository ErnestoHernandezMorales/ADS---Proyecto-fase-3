@model PortalEscolar.Models.Aviso

@{
    ViewData["Title"] = "Nuevo Aviso";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow p-4">

                <h2 class="mb-4">
                    Nuevo Aviso
                </h2>

                <form asp-action="Crear"
                      method="post">

                    <div class="mb-3">

                        <label class="form-label">
                            Título
                        </label>

                        <input asp-for="titulo"
                               class="form-control" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Contenido
                        </label>

                        <textarea asp-for="contenido"
                                  class="form-control">
                        </textarea>

                    </div>

                    <button type="submit"
                            class="btn btn-primary">

                        Guardar Aviso

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>